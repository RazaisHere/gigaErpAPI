DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=giga_workspace
JWT_SECRET=
JWT_EXPIRES_IN=8h
TZ=Asia/Karachi
PORT=3001
CORS_ORIGIN=http://localhost:5173

# nest = local JWT (default). cognito = AWS Cognito is the token issuer.
AUTH_PROVIDER=nest

# Required when AUTH_PROVIDER=cognito
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only if the app client has a secret
COGNITO_CLIENT_SECRET=

# AWS credentials (or use instance/role credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
