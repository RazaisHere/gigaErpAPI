# Workspace DB — Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DB_SSL=true

# Source DB — MySQL (giga_workspace holds src_* views over gigagroup)
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=giga_workspace

# Optional: local MySQL used only by scripts/migrate-mysql-to-supabase.mjs
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=giga_workspace

JWT_SECRET=
JWT_EXPIRES_IN=8h
TZ=Asia/Karachi
PORT=3001
CORS_ORIGIN=http://localhost:5173

AUTH_PROVIDER=nest
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
